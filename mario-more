#include <cs50.h>
#include <stdio.h>
int main()
{
    int height;
    do
    {
        height = get_int ("Height: ");
    }
    while (height <1 || height >8);

    //to print height first
    for (int i=0; i < height; i++)
    {
        //to print spaces1
        for (int j=0; j<height-i-1; j++)
        {
            printf(" ");
        }

        //to print hashes1
        for(int k=0; k<i+1; k++)
        {
            printf("#");
        }

        //to print midspace
        printf("  ");

        //to print hashes2
        for (int l=0; l<i+1; l++)
        {
            printf("#");
        }

        //to print spaces2
        //for (int m=0; m<height-i-1; m++)
        //{
            //printf(" ");
        //}

        //to make a new line
        printf("\n");
    }
}
